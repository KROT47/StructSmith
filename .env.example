# Server
PORT=3000
HOST=0.0.0.0

# SQLite cache, rebuilt from workspace JSON at startup
DATABASE_PATH=./data/architecture.db

# Optional JSON source directory (default: auto-exports/ beside DATABASE_PATH)
# WORKSPACE_FILES_DIR=./architecture

# Auth: none | token
AUTH_MODE=none
APP_TOKEN=

# MCP
MCP_READ_ONLY=false

# In-app agent chat: available only through a localhost connection
AGENT_CHAT_ENABLED=true
AGENT_CHAT_DIR=./data/agent-chat

# Seed the example workspace on first boot
SEED_EXAMPLE=true
